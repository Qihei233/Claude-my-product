# 服务
PORT=3001
NODE_ENV=development

# MySQL（当前 Docker 容器 mysql 映射到宿主机 3307）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=naiwa_learning

# 允许的前端地址，逗号分隔（构建版 4173 / Vite 开发 5173）
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173

# 会话
SESSION_DAYS=7
SESSION_SHORT_HOURS=24
BCRYPT_ROUNDS=12

# 验证码
CODE_TTL_MINUTES=5
CODE_DEV_RETURN=true
CODE_SECRET=replace-with-a-long-random-string
