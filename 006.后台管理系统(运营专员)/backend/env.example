# 后台服务
PORT=3101

# 数据库（只读使用，不会执行任何写操作）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=naiwa_learning

# 管理员账号（密码使用 bcrypt 哈希，可通过 npm run hash-password 生成）
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<bcrypt-hash>
ADMIN_TOKEN_SECRET=<long-random-secret>

# 允许的后台前端地址
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183
